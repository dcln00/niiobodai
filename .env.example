# Stripe secret key. Test key (sk_test_...) for testing, live key (sk_live_...) in production.
# Maps to runtimeConfig.stripeSecretKey. Never commit the real key.
NUXT_STRIPE_SECRET_KEY=

# Optional. Secret used to sign short-lived download links. If left blank, the
# Stripe secret key is used. Set a dedicated random value to decouple the two.
NUXT_DOWNLOAD_SIGNING_SECRET=
